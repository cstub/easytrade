// Qualifying incoming invocations: SERVER spans of one lab service with HTTP status 500-599 in an explicit UTC window.
fetch spans, from:"{{ .start }}", to:"{{ .end }}"
| filter service.namespace == "{{ .ns }}" and service.name == "{{ .service }}"
| filter span.kind == "server"
| filter http.response.status_code >= 500 and http.response.status_code <= 599
| fields start_time, end_time, trace.id, span.id, span.parent_id, span.kind, service.name, service.namespace, deployment.environment.name, http.request.method, http.route, url.path, http.response.status_code, span.status_code, request.is_failed, `http.request.header.x-lab-run-id`, `http.request.header.x-lab-case`
| sort start_time asc
| limit 100
